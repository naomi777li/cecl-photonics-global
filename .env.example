NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://ceclphotonics.com

# Hostinger business-mail SMTP. Store real values only in Coolify environment variables.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@ceclphotonics.com
SMTP_PASS=
INQUIRY_TO=sales@ceclphotonics.com

# Mount a persistent Coolify volume at /app/data before enabling this path.
INQUIRY_LOG_PATH=/app/data/inquiries.ndjson

# Optional SMTP diagnostic endpoint: /api/health/smtp?token=...
DIAG_TOKEN=
