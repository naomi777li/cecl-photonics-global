NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://ceclphotonics.com

# Resend transactional email. Store the real API key only in server runtime variables.
# Never prefix RESEND_API_KEY with NEXT_PUBLIC_.
RESEND_API_KEY=
RFQ_FROM_EMAIL=rfq@ceclphotonics.com
RFQ_TO_EMAIL=info@ceclphotonics.com

# Mount a persistent Coolify volume at /app/data before enabling this path.
INQUIRY_LOG_PATH=/app/data/inquiries.ndjson

# Optional email configuration diagnostic endpoint: /api/health/smtp?token=...
DIAG_TOKEN=
